// engine: dot
// C4, уровень 1 — контекст системы: кто пользуется schemix и с какими внешними системами она связана.
digraph c4_context {
  graph [rankdir=TB, fontname="Arial", fontsize=24, bgcolor="white", pad=0.5, nodesep=0.9, ranksep=1.1,
         splines=spline,
         label=<<B>C4 · Уровень 1. Контекст системы schemix</B><BR/><FONT POINT-SIZE="16">System Context diagram</FONT>>,
         labelloc=t]
  node  [fontname="Arial", fontsize=16, shape=box, style="rounded,filled", color="#00000033",
         fontcolor="white", margin="0.3,0.2", width=3.2]
  edge  [fontname="Arial", fontsize=15, color="#707070", fontcolor="#555555", arrowsize=0.8, style=dashed]

  analyst [fillcolor="#08427b", label=<<B>Аналитик</B><BR/><FONT POINT-SIZE="13">[Person]</FONT><BR/><BR/>Описывает процесс текстом или голосом,<BR/>правит схему, выгружает файл>]

  schemix [fillcolor="#1168bd", width=4, label=<<B>schemix</B><BR/><FONT POINT-SIZE="13">[Software System]</FONT><BR/><BR/>Строит BPMN 2.0 по описанию процесса,<BR/>задаёт уточняющие вопросы,<BR/>хранит ревизии и историю>]

  llm [fillcolor="#666666", label=<<B>Провайдер языковой модели</B><BR/><FONT POINT-SIZE="13">[Software System, внешняя]</FONT><BR/><BR/>OpenAI-совместимый chat/completions:<BR/>DeepSeek V4.1 Flash, Qwen3.6 в Yandex Cloud>]
  stt [fillcolor="#666666", label=<<B>Сервис распознавания речи</B><BR/><FONT POINT-SIZE="13">[Software System, внешняя]</FONT><BR/><BR/>OpenAI-совместимый<BR/>/audio/transcriptions>]
  ext [fillcolor="#666666", label=<<B>BPMN-редакторы и Sila Union</B><BR/><FONT POINT-SIZE="13">[Software System, внешняя]</FONT><BR/><BR/>bpmn.io, Camunda Modeler,<BR/>система моделирования архитектуры>]

  analyst -> schemix [label="  описывает процесс, правит схему,\n  отвечает на вопросы\n  [HTTPS, WebSocket]"]
  schemix -> llm [label="  извлекает факты по JSON-схеме\n  [HTTPS, JSON]"]
  schemix -> stt [label="  распознаёт фразы диктовки\n  [HTTPS, WAV]"]
  analyst -> ext [label="  открывает выгруженные\n  BPMN 2.0 и EPC"]

  { rank=same; llm; stt }
}
