<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Process_ManualEdit" targetNamespace="http://schemix.local/it-project" exporter="it-project diagrams" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_Process_ManualEdit">
    <bpmn:participant id="Participant_Process_ManualEdit" name="schemix: ручная правка схемы" processRef="Process_ManualEdit" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ManualEdit" name="schemix: ручная правка схемы" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_ManualEdit">
      <bpmn:lane id="Lane_Analyst" name="Аналитик">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Editor" name="Браузер">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Server" name="Сервер schemix">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Нужно изменить схему">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Изменить схему на холсте">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T2" name="Отправить XML с базовой ревизией (автосохранение)">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T3" name="Заблокировать диаграмму и сверить базовую ревизию">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Ревизия текущая?">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T4" name="Показать конфликт ревизий">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="T5" name="Загрузить серверную версию или скачать черновик">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E2" name="Правка не сохранена">
      <bpmn:incoming>F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T6" name="Проверить профиль редактора и XSD">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G2" name="Схема допустима?">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T7" name="Показать замечания проверки">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="T8" name="Исправить замечания">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T9" name="Записать ревизию «ручная правка»">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G3" name="Идёт запрос агента?">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T10" name="Пометить запрос агента устаревшим">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G4" name="">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T11" name="Разослать событие revision.committed">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="T12" name="Обновить схему и номер ревизии">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E1" name="Правка сохранена">
      <bpmn:incoming>F20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F4" sourceRef="T3" targetRef="G1" />
    <bpmn:sequenceFlow id="F5" name="нет" sourceRef="G1" targetRef="T4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Ревизия текущая: нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F6" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="F7" sourceRef="T5" targetRef="E2" />
    <bpmn:sequenceFlow id="F8" name="да" sourceRef="G1" targetRef="T6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Ревизия текущая: да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F9" sourceRef="T6" targetRef="G2" />
    <bpmn:sequenceFlow id="F10" name="нет" sourceRef="G2" targetRef="T7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Схема допустима: нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F11" sourceRef="T7" targetRef="T8" />
    <bpmn:sequenceFlow id="F12" sourceRef="T8" targetRef="T1" />
    <bpmn:sequenceFlow id="F13" name="да" sourceRef="G2" targetRef="T9">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Схема допустима: да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F14" sourceRef="T9" targetRef="G3" />
    <bpmn:sequenceFlow id="F15" name="нет" sourceRef="G3" targetRef="G4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Идёт запрос агента: нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F16" name="да" sourceRef="G3" targetRef="T10">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Идёт запрос агента: да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F17" sourceRef="T10" targetRef="G4" />
    <bpmn:sequenceFlow id="F18" sourceRef="G4" targetRef="T11" />
    <bpmn:sequenceFlow id="F19" sourceRef="T11" targetRef="T12" />
    <bpmn:sequenceFlow id="F20" sourceRef="T12" targetRef="E1" />
  </bpmn:process>
