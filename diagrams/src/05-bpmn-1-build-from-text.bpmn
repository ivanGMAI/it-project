<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Process_BuildFromText" targetNamespace="http://schemix.local/it-project" exporter="it-project diagrams" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_Process_BuildFromText">
    <bpmn:participant id="Participant_Process_BuildFromText" name="schemix: построение схемы по описанию процесса" processRef="Process_BuildFromText" />
    <bpmn:participant id="Participant_LLM" name="Провайдер языковой модели" />
    <bpmn:messageFlow id="M1" name="роль и JSON-схема" sourceRef="T4" targetRef="Participant_LLM" />
    <bpmn:messageFlow id="M2" name="факты с цитатами" sourceRef="Participant_LLM" targetRef="T4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BuildFromText" name="schemix: построение схемы по описанию процесса" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_BuildFromText">
      <bpmn:lane id="Lane_Analyst" name="Аналитик">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Server" name="Сервер schemix">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Агент (worker)">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Нужна схема процесса">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Описать процесс и запустить построение">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T2" name="Сохранить сообщение и поставить запрос в очередь">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T3" name="Взять запрос из очереди по lease">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T4" name="Извлечь факты ролями модели">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T5" name="Собрать ChangeSet на копии и проверить схему">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Нужно уточнение?">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T6" name="Ответить на вопросы агента">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G2" name="Изменение рискованное?">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T7" name="Просмотреть предложение и предпросмотр">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G3" name="Применить?">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E2" name="Изменения отклонены">
      <bpmn:incoming>F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T8" name="Сверить базовую ревизию">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G4" name="Ревизия текущая?">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E3" name="Запрос устарел">
      <bpmn:incoming>F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T9" name="Записать ревизию и оповестить клиента">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T10" name="Проверить схему в редакторе">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E1" name="Схема построена">
      <bpmn:incoming>F19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F4" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="F5" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="F6" sourceRef="T5" targetRef="G1" />
    <bpmn:sequenceFlow id="F7" name="да" sourceRef="G1" targetRef="T6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нужно уточнение: да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F8" name="нет" sourceRef="G1" targetRef="G2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нужно уточнение: нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F9" sourceRef="T6" targetRef="T4" />
    <bpmn:sequenceFlow id="F10" name="да" sourceRef="G2" targetRef="T7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Изменение рискованное: да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F11" name="нет" sourceRef="G2" targetRef="T8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Изменение рискованное: нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F12" sourceRef="T7" targetRef="G3" />
    <bpmn:sequenceFlow id="F13" name="нет" sourceRef="G3" targetRef="E2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Применить: нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F14" name="да" sourceRef="G3" targetRef="T8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Применить: да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F15" sourceRef="T8" targetRef="G4" />
    <bpmn:sequenceFlow id="F16" name="да" sourceRef="G4" targetRef="T9">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Ревизия текущая: да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F17" name="нет" sourceRef="G4" targetRef="E3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Ревизия текущая: нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F18" sourceRef="T9" targetRef="T10" />
    <bpmn:sequenceFlow id="F19" sourceRef="T10" targetRef="E1" />
  </bpmn:process>
