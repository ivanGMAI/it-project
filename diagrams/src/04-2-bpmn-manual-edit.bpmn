<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_ManualEdit" targetNamespace="http://schemix.local/bpmn" exporter="schemix diagrams" exporterVersion="2">
  <bpmn:collaboration id="Collab_ManualEdit">
    <bpmn:participant id="Pool_ManualEdit" name="schemix: ручная правка схемы" processRef="Process_ManualEdit" />
    
    
  </bpmn:collaboration>
  <bpmn:process id="Process_ManualEdit" name="schemix: ручная правка схемы" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ManualEdit">
      <bpmn:lane id="Lane_Analyst" name="Аналитик"><bpmn:flowNodeRef>S1</bpmn:flowNodeRef><bpmn:flowNodeRef>G0</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>T5</bpmn:flowNodeRef><bpmn:flowNodeRef>E2</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Browser" name="Браузер (редактор)"><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>T4</bpmn:flowNodeRef><bpmn:flowNodeRef>T7</bpmn:flowNodeRef><bpmn:flowNodeRef>T12</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Server" name="Сервер schemix"><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>T6</bpmn:flowNodeRef><bpmn:flowNodeRef>G2</bpmn:flowNodeRef><bpmn:flowNodeRef>T9</bpmn:flowNodeRef><bpmn:flowNodeRef>G3</bpmn:flowNodeRef><bpmn:flowNodeRef>T10</bpmn:flowNodeRef><bpmn:flowNodeRef>G4</bpmn:flowNodeRef><bpmn:flowNodeRef>T11</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Нужно изменить схему"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="G0" name=""><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T1" name="Изменить схему на холсте"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="T2" name="Отправить XML с базовой ревизией (автосохранение)"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="T3" name="Заблокировать диаграмму и сверить базовую ревизию"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Ревизия текущая?"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="T4" name="Показать конфликт ревизий"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="T5" name="Загрузить версию сервера или скачать черновик"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="E2" name="Правка не сохранена"><bpmn:incoming>Flow_8</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="T6" name="Проверить профиль редактора и XSD"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G2" name="Схема допустима?"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="T7" name="Показать замечания проверки"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:task>
    <bpmn:serviceTask id="T9" name="Записать ревизию «ручная правка»"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G3" name="Есть активный запрос агента?"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T10" name="Перенести предложение или пометить запрос устаревшим"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G4" name=""><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T11" name="Разослать событие revision.committed"><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="T12" name="Обновить схему и номер ревизии"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="E1" name="Правка сохранена"><bpmn:incoming>Flow_20</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="S1" targetRef="G0"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="G0" targetRef="T1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="T1" targetRef="T2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="T2" targetRef="T3"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="T3" targetRef="G1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" name="нет" sourceRef="G1" targetRef="T4"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Ревизия текущая?: нет</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="T4" targetRef="T5"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="T5" targetRef="E2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" name="да" sourceRef="G1" targetRef="T6"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Ревизия текущая?: да</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="T6" targetRef="G2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" name="нет" sourceRef="G2" targetRef="T7"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Схема допустима?: нет</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="T7" targetRef="G0"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" name="да" sourceRef="G2" targetRef="T9"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Схема допустима?: да</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="T9" targetRef="G3"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" name="да" sourceRef="G3" targetRef="T10"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Есть активный запрос агента?: да</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" name="нет" sourceRef="G3" targetRef="G4"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Есть активный запрос агента?: нет</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="T10" targetRef="G4"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="G4" targetRef="T11"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="T11" targetRef="T12"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="T12" targetRef="E1"></bpmn:sequenceFlow>
  </bpmn:process>
