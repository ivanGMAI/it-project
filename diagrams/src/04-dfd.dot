// engine: dot
// DFD уровня 1 (нотация Гейна–Сарсона): процесс 0 контекстной диаграммы разложен на шесть
// процессов. Скруглённый прямоугольник с номером — процесс, прямоугольник с ячейкой D — хранилище,
// прямоугольник с тенью — внешняя сущность, стрелка — поток данных.
digraph dfd {
  graph [rankdir=TB, fontname="Arial", fontsize=24, bgcolor="white", pad=0.3,
         nodesep=0.45, ranksep=0.55, splines=spline, newrank=true,
         label=<<B>Диаграмма потоков данных schemix</B><BR/><FONT POINT-SIZE="16">DFD уровня 1, нотация Гейна–Сарсона</FONT>>,
         labelloc=t]
  node  [fontname="Arial", fontsize=16]
  edge  [fontname="Arial", fontsize=14, color="#333333", arrowsize=0.9, penwidth=1.2]

  // ---------- внешние сущности ----------
  node [shape=box, style="filled,bold", fillcolor="#f2f2f2", margin="0.3,0.12"]
  analyst  [fillcolor="#eef1ff", color="#2b4dff", label=<<B>Аналитик</B>>]
  analyst2 [fillcolor="#eef1ff", color="#2b4dff", label=<<B>Аналитик</B><BR/><FONT POINT-SIZE="13">та же сущность, копия</FONT>>]
  stt      [label=<<B>Сервис<BR/>распознавания речи</B>>]
  llm      [label=<<B>Провайдер<BR/>языковой модели</B>>]
  ext      [label=<<B>Внешние системы<BR/>моделирования</B><BR/><FONT POINT-SIZE="13">bpmn.io, Camunda, Sila Union</FONT>>]

  // ---------- процессы ----------
  node [shape=plain, style="", margin=0]
  p1 [label=<<TABLE STYLE="ROUNDED" BORDER="1.5" CELLBORDER="0" CELLPADDING="6" BGCOLOR="white">
      <TR><TD><B>1</B></TD></TR><HR/><TR><TD>Принять описание<BR/>процесса</TD></TR></TABLE>>]
  p2 [label=<<TABLE STYLE="ROUNDED" BORDER="1.5" CELLBORDER="0" CELLPADDING="6" BGCOLOR="white">
      <TR><TD><B>2</B></TD></TR><HR/><TR><TD>Извлечь факты<BR/>ролями агента</TD></TR></TABLE>>]
  p3 [label=<<TABLE STYLE="ROUNDED" BORDER="1.5" CELLBORDER="0" CELLPADDING="6" BGCOLOR="white">
      <TR><TD><B>3</B></TD></TR><HR/><TR><TD>Собрать ChangeSet<BR/>и проверить схему</TD></TR></TABLE>>]
  p4 [label=<<TABLE STYLE="ROUNDED" BORDER="1.5" CELLBORDER="0" CELLPADDING="6" BGCOLOR="white">
      <TR><TD><B>4</B></TD></TR><HR/><TR><TD>Уточнить<BR/>и подтвердить</TD></TR></TABLE>>]
  p5 [label=<<TABLE STYLE="ROUNDED" BORDER="1.5" CELLBORDER="0" CELLPADDING="6" BGCOLOR="white">
      <TR><TD><B>5</B></TD></TR><HR/><TR><TD>Записать<BR/>ревизию</TD></TR></TABLE>>]
  p6 [label=<<TABLE STYLE="ROUNDED" BORDER="1.5" CELLBORDER="0" CELLPADDING="6" BGCOLOR="white">
      <TR><TD><B>6</B></TD></TR><HR/><TR><TD>Выгрузить<BR/>и проверить оформление</TD></TR></TABLE>>]

  // ---------- хранилища ----------
  d1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#fafafa">
      <TR><TD SIDES="TBL" BGCOLOR="#e8e8e8"><B>D1</B></TD><TD SIDES="TB">Диаграммы и ревизии</TD></TR></TABLE>>]
  d2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#fafafa">
      <TR><TD SIDES="TBL" BGCOLOR="#e8e8e8"><B>D2</B></TD><TD SIDES="TB">Чаты и сообщения</TD></TR></TABLE>>]
  d3 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#fafafa">
      <TR><TD SIDES="TBL" BGCOLOR="#e8e8e8"><B>D3</B></TD><TD SIDES="TB">Запросы агенту<BR/>и артефакты ролей</TD></TR></TABLE>>]
  d4 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#fafafa">
      <TR><TD SIDES="TBL" BGCOLOR="#e8e8e8"><B>D4</B></TD><TD SIDES="TB">Уточнения, предложения,<BR/>предпросмотры</TD></TR></TABLE>>]
  d5 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#fafafa">
      <TR><TD SIDES="TBL" BGCOLOR="#e8e8e8"><B>D5</B></TD><TD SIDES="TB">Журнал событий<BR/>диаграммы</TD></TR></TABLE>>]

  // ---------- строки раскладки ----------
  { rank=same; analyst; stt }
  { rank=same; p1 }
  { rank=same; d2; d3; llm }
  { rank=same; p2 }
  { rank=same; p3; d1 }
  { rank=same; d4; p5; d5 }
  { rank=same; p4; p6 }
  { rank=same; analyst2; ext }

  // ---------- потоки ----------
  analyst -> p1 [label="описание:\nтекст, файл, голос"]
  p1 -> stt     [label="аудио фразы"]
  stt -> p1     [label="текст фразы"]
  p1 -> d2      [label="сообщение"]
  p1 -> d3      [label="новый запрос"]

  d3 -> p2      [label="запрос из очереди"]
  d1 -> p2      [label="граф схемы"]
  p2 -> llm     [label="роль,\nJSON-схема"]
  llm -> p2     [label="факты с цитатами"]
  p2 -> d3      [label="артефакты ролей"]
  p2 -> p3      [label="факты"]

  d1 -> p3      [label="XML ревизии"]
  p3 -> d5      [label="этапы, черновик"]
  p3 -> d4      [label="вопросы,\nпредложение"]
  p3 -> p5      [label="безопасная\nправка"]

  d4 -> p4      [label="вопросы,\nпредложение"]
  p4 -> analyst2 [label="вопросы,\nриски"]
  analyst -> p4 [label="ответы, решение,\nправка"]
  p4 -> d3      [label="ответы"]
  p4 -> p5      [label="подтверждённая\nправка"]

  analyst -> p5 [label="ручная правка,\nимпорт, возврат"]
  d1 -> p5      [label="текущая ревизия"]
  p5 -> d1      [label="новая ревизия"]
  p5 -> d5      [label="revision.committed"]
  d5 -> analyst2 [label="прогресс,\nчерновик,\nревизии"]

  analyst -> p6 [label="формат выгрузки"]
  d1 -> p6      [label="XML ревизии"]
  p6 -> analyst2 [label="файлы,\nзамечания"]
  p6 -> ext     [label="BPMN 2.0, EPC"]
}
