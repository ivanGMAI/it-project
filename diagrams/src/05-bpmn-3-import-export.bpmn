      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="516" y="280" /><di:waypoint x="582" y="280" /><bpmndi:BPMNLabel><dc:Bounds x="524" y="259" width="22" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="490" y="306" /><di:waypoint x="490" y="412" /><di:waypoint x="582" y="412" /><bpmndi:BPMNLabel><dc:Bounds x="497" y="312" width="29" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="758" y="280" /><di:waypoint x="834" y="280" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="758" y="412" /><di:waypoint x="860" y="412" /><di:waypoint x="860" y="306" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="860" y="254" /><di:waypoint x="860" y="138" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="948" y="90" /><di:waypoint x="1002" y="90" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="1090" y="138" /><di:waypoint x="1090" y="232" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="1178" y="280" /><di:waypoint x="1205" y="280" /><di:waypoint x="1205" y="109" /><di:waypoint x="1232" y="109" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F14_di" bpmnElement="F14"><di:waypoint x="1408" y="90" /><di:waypoint x="1481" y="90" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M1_di" bpmnElement="M1"><di:waypoint x="1320" y="138" /><di:waypoint x="1320" y="570" /><bpmndi:BPMNLabel><dc:Bounds x="1330" y="345" width="145" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
