<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Process_ImportExport" targetNamespace="http://schemix.local/it-project" exporter="it-project diagrams" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_Process_ImportExport">
    <bpmn:participant id="Participant_Process_ImportExport" name="schemix: импорт и выгрузка BPMN-файла" processRef="Process_ImportExport" />
    <bpmn:participant id="Participant_Ext" name="Внешний BPMN-редактор или Sila Union" />
    <bpmn:messageFlow id="M1" name="файл BPMN или EPC" sourceRef="T8" targetRef="Participant_Ext" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ImportExport" name="schemix: импорт и выгрузка BPMN-файла" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_ImportExport">
      <bpmn:lane id="Lane_Analyst" name="Аналитик">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Server" name="Сервер schemix">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Есть готовый файл BPMN">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Загрузить файл на стартовой странице">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T2" name="Разобрать XML и проверить по XSD OMG">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="XML корректен?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E2" name="Импорт отклонён">
      <bpmn:incoming>F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G2" name="Профиль редактора?">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T3" name="Создать диаграмму, ревизию «импорт» и чат">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T4" name="Сохранить оригинал байт в байт, открыть только для чтения">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G3" name="">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T5" name="Просмотреть схему, при необходимости доработать">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T6" name="Выбрать формат выгрузки">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T7" name="Сформировать файл: BPMN, SVG, MD, DOCX или EPC">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T8" name="Скачать файл и открыть во внешнем редакторе">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E1" name="Схема передана">
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="G1" />
    <bpmn:sequenceFlow id="F4" name="нет" sourceRef="G1" targetRef="E2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">XML корректен: нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F5" name="да" sourceRef="G1" targetRef="G2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">XML корректен: да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F6" name="да" sourceRef="G2" targetRef="T3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Профиль редактора: да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F7" name="нет" sourceRef="G2" targetRef="T4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Профиль редактора: нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F8" sourceRef="T3" targetRef="G3" />
    <bpmn:sequenceFlow id="F9" sourceRef="T4" targetRef="G3" />
    <bpmn:sequenceFlow id="F10" sourceRef="G3" targetRef="T5" />
    <bpmn:sequenceFlow id="F11" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="F12" sourceRef="T6" targetRef="T7" />
    <bpmn:sequenceFlow id="F13" sourceRef="T7" targetRef="T8" />
    <bpmn:sequenceFlow id="F14" sourceRef="T8" targetRef="E1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_ImportExport">
    <bpmndi:BPMNPlane id="Plane_Process_ImportExport" bpmnElement="Collaboration_Process_ImportExport">
      <bpmndi:BPMNShape id="Participant_Process_ImportExport_di" bpmnElement="Participant_Process_ImportExport" isHorizontal="true"><dc:Bounds x="100" y="220" width="1930" height="490" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Analyst_di" bpmnElement="Lane_Analyst" isHorizontal="true"><dc:Bounds x="130" y="220" width="1900" height="190" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Server_di" bpmnElement="Lane_Server" isHorizontal="true"><dc:Bounds x="130" y="410" width="1900" height="300" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Ext_di" bpmnElement="Participant_Ext" isHorizontal="true"><dc:Bounds x="100" y="80" width="1930" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S1_di" bpmnElement="S1"><dc:Bounds x="237" y="297" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="200" y="339" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="320" y="265" width="160" height="100" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="500" y="460" width="160" height="100" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1"><dc:Bounds x="700" y="485" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="670" y="439" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E2_di" bpmnElement="E2"><dc:Bounds x="707" y="612" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="670" y="654" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G2_di" bpmnElement="G2"><dc:Bounds x="810" y="485" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="780" y="439" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="900" y="460" width="160" height="100" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="900" y="580" width="160" height="100" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G3_di" bpmnElement="G3"><dc:Bounds x="1100" y="485" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1070" y="439" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T5_di" bpmnElement="T5"><dc:Bounds x="1190" y="265" width="160" height="100" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T6_di" bpmnElement="T6"><dc:Bounds x="1370" y="265" width="160" height="100" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T7_di" bpmnElement="T7"><dc:Bounds x="1550" y="460" width="160" height="100" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T8_di" bpmnElement="T8"><dc:Bounds x="1730" y="265" width="160" height="100" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E1_di" bpmnElement="E1"><dc:Bounds x="1937" y="297" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1900" y="339" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="273" y="315" /><di:waypoint x="320" y="315" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="480" y="315" /><di:waypoint x="490" y="315" /><di:waypoint x="490" y="510" /><di:waypoint x="500" y="510" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="660" y="510" /><di:waypoint x="700" y="510" /></bpmndi:BPMNEdge>
