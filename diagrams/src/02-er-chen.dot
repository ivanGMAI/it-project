  correction -- correction_a0
  correction_a1 [pos="14.08,-10.53!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label="текст"]
  correction -- correction_a1
  correction_a2 [pos="11.13,-9.53!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label="дата"]
