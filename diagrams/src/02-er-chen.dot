  proposal [pos="16.80,0.00!", shape=box, style="filled", fillcolor="#eef1ff", color="#2b4dff", penwidth=1.8, peripheries=1, margin="0.7,0.2", fontsize=19, label=<<B>ПРЕДЛОЖЕНИЕ</B>>]
  proposal_a0 [pos="19.31,0.66!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label=<<U>ID</U>>]
