// engine: neato
// ER-диаграмма в нотации Чена. Сгенерирована по схеме БД schemix (backend/migration/versions).
// Прямоугольник — сущность, двойной — слабая; ромб — связь, двойной — идентифицирующая;
// эллипс — атрибут: подчёркнут — ключ, пунктир снизу — частичный ключ, двойной — многозначный,
// пунктирный — производный, с ветками — составной. Двойная линия — полное участие.
// Координаты узлов закреплены (pos=...!), Graphviz только рисует.
graph chen {
  graph [fontname="Arial", fontsize=26, bgcolor="white", pad=0.5, overlap=true, splines=false,
         notranslate=true,
         label=<<B>ER-диаграмма schemix в нотации Чена</B><BR/><FONT POINT-SIZE="18">концептуальная модель данных</FONT>>,
         labelloc=t]
  node  [fontname="Arial", fontsize=18]
  edge  [fontname="Arial", fontsize=20, color="#222222", penwidth=1.3]

  diagram [pos="0.00,7.84!", shape=box, style="filled", fillcolor="#eef1ff", color="#2b4dff", penwidth=1.8, peripheries=1, margin="0.7,0.2", fontsize=19, label=<<B>ДИАГРАММА</B>>]
  diagram_a0 [pos="2.34,8.72!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label=<<U>ID</U>>]
  diagram -- diagram_a0
  diagram_a1 [pos="2.40,6.28!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label="название"]
  diagram -- diagram_a1
  diagram_a2 [pos="-1.91,6.60!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label="текущая ревизия"]
  diagram -- diagram_a2
  diagram_a3 [pos="-3.39,7.84!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label="редактируемость"]
  diagram -- diagram_a3
  diagram_a4 [pos="-2.92,9.43!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", peripheries=2, label="причины\n«только чтение»"]
  diagram -- diagram_a4
  diagram_a5 [pos="0.88,9.97!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label="дата изменения"]
  diagram -- diagram_a5

  revision [pos="9.60,7.84!", shape=box, style="filled", fillcolor="#eef1ff", color="#2b4dff", penwidth=1.8, peripheries=2, margin="0.7,0.2", fontsize=19, label=<<B>РЕВИЗИЯ</B>>]
  revision_a0 [pos="7.26,8.72!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label=<<TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD SIDES="B" BORDER="1" STYLE="dashed">номер</TD></TR></TABLE>>]
  revision -- revision_a0
  revision_a1 [pos="8.39,9.99!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label="BPMN XML с DI"]
  revision -- revision_a1
  revision_a2 [pos="10.87,9.39!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label="исходный XML"]
  revision -- revision_a2
  revision_a3 [pos="12.87,8.70!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label="источник"]
