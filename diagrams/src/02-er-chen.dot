  revision_a4 [pos="12.05,7.10!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label="дата создания"]
  revision -- revision_a4

  chat [pos="0.00,3.92!", shape=box, style="filled", fillcolor="#eef1ff", color="#2b4dff", penwidth=1.8, peripheries=1, margin="0.7,0.2", fontsize=19, label=<<B>ЧАТ</B>>]
  chat_a0 [pos="2.21,4.93!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label=<<U>ID</U>>]
  chat -- chat_a0
  chat_a1 [pos="2.78,2.66!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label="название"]
  chat -- chat_a1
  chat_a2 [pos="-2.45,3.18!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label="дата создания"]
