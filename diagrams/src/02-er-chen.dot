  chat_a3 [pos="-2.94,5.02!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label="дата удаления"]
  chat -- chat_a3

  message [pos="0.00,0.00!", shape=box, style="filled", fillcolor="#eef1ff", color="#2b4dff", penwidth=1.8, peripheries=1, margin="0.7,0.2", fontsize=19, label=<<B>СООБЩЕНИЕ</B>>]
  message_a0 [pos="1.91,1.24!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label=<<U>ID</U>>]
  message -- message_a0
  message_a1 [pos="1.70,-1.91!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label="порядковый номер"]
  message -- message_a1
  message_a2 [pos="-1.14,-1.59!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label="вид"]
