  round_a0 [pos="-0.87,-6.15!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label=<<TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD SIDES="B" BORDER="1" STYLE="dashed">номер</TD></TR></TABLE>>]
