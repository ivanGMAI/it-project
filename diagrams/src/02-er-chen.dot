  message_a3 [pos="-3.19,-0.75!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label="текст"]
  message -- message_a3
  message_a4 [pos="-2.70,1.47!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", peripheries=2, label="привязки\nк элементам"]
  message -- message_a4

  run [pos="7.20,0.00!", shape=box, style="filled", fillcolor="#eef1ff", color="#2b4dff", penwidth=1.8, peripheries=1, margin="0.7,0.2", fontsize=19, label=<<B>ЗАПРОС АГЕНТУ</B>>]
  run_a0 [pos="6.19,1.63!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label=<<U>ID</U>>]
  run -- run_a0
  run_a1 [pos="4.88,1.67!", shape=ellipse, style="filled", fillcolor="white", color="#555555", margin="0.06,0.03", label="вид"]
