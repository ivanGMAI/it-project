<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_ImportExport" targetNamespace="http://schemix.local/bpmn" exporter="schemix diagrams" exporterVersion="2">
  <bpmn:collaboration id="Collab_ImportExport">
    <bpmn:participant id="Pool_ImportExport" name="schemix: импорт и выгрузка BPMN-файла" processRef="Process_ImportExport" />
    <bpmn:participant id="Participant_Ext" name="BPMN-редактор (bpmn.io, Camunda Modeler)" />
    <bpmn:messageFlow id="Message_1" name="файл .bpmn" sourceRef="Participant_Ext" targetRef="T1" />
    <bpmn:messageFlow id="Message_2" name="файл .bpmn" sourceRef="T8" targetRef="Participant_Ext" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ImportExport" name="schemix: импорт и выгрузка BPMN-файла" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ImportExport">
      <bpmn:lane id="Lane_Analyst" name="Аналитик"><bpmn:flowNodeRef>S1</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>T5</bpmn:flowNodeRef><bpmn:flowNodeRef>T6</bpmn:flowNodeRef><bpmn:flowNodeRef>T8</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Server" name="Сервер schemix"><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>E2</bpmn:flowNodeRef><bpmn:flowNodeRef>G2</bpmn:flowNodeRef><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>T4</bpmn:flowNodeRef><bpmn:flowNodeRef>G3</bpmn:flowNodeRef><bpmn:flowNodeRef>T9</bpmn:flowNodeRef><bpmn:flowNodeRef>T7</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Есть файл BPMN"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="T1" name="Загрузить файл на стартовой странице"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="T2" name="Разобрать XML и проверить по XSD OMG"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="XML корректен?"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="E2" name="Импорт отклонён"><bpmn:incoming>Flow_4</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="G2" name="Схема в профиле редактора?"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T3" name="Привести схему к профилю редактора"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="T4" name="Взять оригинал байт в байт, пометить «только чтение»"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G3" name=""><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T9" name="Создать диаграмму, ревизию «импорт» и чат"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="T5" name="Просмотреть схему в редакторе"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T6" name="Выбрать формат выгрузки"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="T7" name="Сформировать файл: BPMN, SVG, MD или DOCX"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="T8" name="Скачать файл"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="E1" name="Файл выгружен"><bpmn:incoming>Flow_15</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="S1" targetRef="T1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="T1" targetRef="T2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="T2" targetRef="G1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" name="нет" sourceRef="G1" targetRef="E2"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">XML корректен?: нет</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" name="да" sourceRef="G1" targetRef="G2"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">XML корректен?: да</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" name="да" sourceRef="G2" targetRef="T3"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Схема в профиле редактора?: да</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" name="нет" sourceRef="G2" targetRef="T4"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Схема в профиле редактора?: нет</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="T3" targetRef="G3"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="T4" targetRef="G3"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="G3" targetRef="T9"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="T9" targetRef="T5"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="T5" targetRef="T6"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="T6" targetRef="T7"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="T7" targetRef="T8"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="T8" targetRef="E1"></bpmn:sequenceFlow>
  </bpmn:process>
