// engine: dot
// C4, уровень 3 — компоненты контейнера «API-приложение и worker агента» (backend/src/bpmn_assistant).
// Поток слева направо: веб-приложение → контроллеры → сценарии → сервисы и роли → адаптеры → внешние системы.
// Рассчитана на лист A3 альбомный.
digraph c4_components {
  graph [rankdir=LR, fontname="Arial", fontsize=24, bgcolor="white", pad=0.3, nodesep=0.3, ranksep=0.75,
         splines=spline, newrank=true,
         label=<<B>C4 · Уровень 3. Компоненты бэкенда schemix</B><BR/><FONT POINT-SIZE="16">Component diagram · контейнер «API-приложение и worker агента»</FONT>>,
         labelloc=t]
  node  [fontname="Arial", fontsize=15, shape=box, style="rounded,filled", color="#00000033",
         fontcolor="black", fillcolor="#85bbf0", margin="0.18,0.12", width=2.6]
  edge  [fontname="Arial", fontsize=13, color="#555555", fontcolor="#333333", arrowsize=0.8, style=dashed]

  spa [fillcolor="#1f6fb2", fontcolor="white", label=<<B>Веб-приложение</B><BR/><FONT POINT-SIZE="13">[React 19, bpmn-js 18]</FONT><BR/>через nginx /api>]

  subgraph cluster_backend {
    label=<<B>API-приложение и worker агента</B>  <FONT POINT-SIZE="14">[Python 3.12, FastAPI]</FONT>>;
    fontsize=18; fontcolor="#333333"; style="dashed,rounded"; color="#444444"; margin=14

    http [label=<<B>HTTP API</B><BR/><FONT POINT-SIZE="13">[controller/http]</FONT><BR/>Маршруты OpenAPI,<BR/>идемпотентность>]
    ws [label=<<B>Поток событий</B><BR/><FONT POINT-SIZE="13">[controller/ws]</FONT><BR/>Прогресс, черновик,<BR/>ревизии; resync>]

    workspace [label=<<B>Сценарии</B><BR/><FONT POINT-SIZE="13">[application/workspace]</FONT><BR/>Диаграммы, ревизии (CAS),<BR/>чаты, импорт, экспорт>]
    dictation [label=<<B>Диктовка</B><BR/><FONT POINT-SIZE="13">[application/dictation]</FONT><BR/>Фразы → текст → черновик>]
    worker [label=<<B>Worker агента</B><BR/><FONT POINT-SIZE="13">[application/agent]</FONT><BR/>Берёт запросы по lease>]
    docs [label=<<B>Чтение документов</B><BR/><FONT POINT-SIZE="13">[adapter/documents]</FONT><BR/>Текст из .docx и .pdf>]

    runner [label=<<B>Runner агента</B><BR/><FONT POINT-SIZE="13">[application/agent]</FONT><BR/>Роли, бюджеты, checkpoints,<BR/>ChangeSet, оценка риска>]
    roles [label=<<B>Роли агента</B><BR/><FONT POINT-SIZE="13">[adapter/agents]</FONT><BR/>Промпты и JSON-схемы:<BR/>intent, entities, flow…>]
    bpmn [label=<<B>BPMN-модуль</B><BR/><FONT POINT-SIZE="13">[service/bpmn, adapter/bpmn]</FONT><BR/>XSD, граф, раскладка,<BR/>нормоконтроль, экспорт>]

    llmc [label=<<B>Клиент модели</B><BR/><FONT POINT-SIZE="13">[порт LanguageModel]</FONT><BR/>OpenAI-совместимый;<BR/>адаптер Claude Agent SDK>]
    sttc [label=<<B>Клиент распознавания</B><BR/><FONT POINT-SIZE="13">[порт SpeechToText]</FONT><BR/>/audio/transcriptions>]
    repo [label=<<B>Хранилище</B><BR/><FONT POINT-SIZE="13">[порт UnitOfWork]</FONT><BR/>Репозитории, транзакции,<BR/>psycopg 3>]

    { rank=same; http; ws }
    { rank=same; workspace; dictation; worker; docs }
    { rank=same; roles -> bpmn -> runner [style=invis] }
    { rank=same; llmc; sttc; repo }
  }

  llm [fillcolor="#666666", fontcolor="white", label=<<B>Провайдер<BR/>языковой модели</B><BR/><FONT POINT-SIZE="13">[внешняя система]</FONT>>]
  stt [fillcolor="#666666", fontcolor="white", label=<<B>Сервис<BR/>распознавания речи</B><BR/><FONT POINT-SIZE="13">[внешняя система]</FONT>>]
  db [shape=cylinder, style="filled", fillcolor="#1f6fb2", fontcolor="white", label=<<B>База данных</B><BR/><FONT POINT-SIZE="13">[PostgreSQL 16]</FONT>>]
  { rank=same; llm; stt; db }

  spa -> http [label="команды\n[HTTPS]"]
  spa -> ws [label="события\n[WebSocket]"]
  http -> workspace [label="вызывает"]
  http -> dictation [label="фразы"]
  http -> docs [label="документ"]
  worker -> runner [label="запускает"]
  runner -> roles [label="роль"]
  runner -> bpmn [label="ChangeSet"]
  workspace -> bpmn [label="проверка,\nэкспорт"]
  dictation -> roles [label="dictation"]
  dictation -> sttc [label="фраза"]
  roles -> llmc [label="generate"]
  runner -> repo [label="checkpoints,\nревизия"]
  workspace -> repo [label="транзакции"]
  ws -> repo [label="журнал"]
  worker -> repo [label="lease", constraint=false]
  repo -> db [label="SQL"]
  llmc -> llm [label="[HTTPS, JSON]"]
  sttc -> stt [label="[HTTPS, WAV]"]
}
