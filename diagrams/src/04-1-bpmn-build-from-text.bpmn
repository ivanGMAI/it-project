    <bpmn:sequenceFlow id="Flow_10" name="нет" sourceRef="G1" targetRef="G2"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нужно уточнение?: нет</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" name="да" sourceRef="G2" targetRef="T7"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Изменение рискованное?: да</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="T7" targetRef="G3"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" name="нет" sourceRef="G3" targetRef="E2"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Применить?: нет</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" name="да" sourceRef="G3" targetRef="G4"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Применить?: да</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" name="нет" sourceRef="G2" targetRef="G4"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Изменение рискованное?: нет</bpmn:conditionExpression></bpmn:sequenceFlow>
