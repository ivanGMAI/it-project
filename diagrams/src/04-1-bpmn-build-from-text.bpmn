  <bpmn:collaboration id="Collab_BuildFromText">
    <bpmn:participant id="Pool_BuildFromText" name="schemix: построение схемы по описанию процесса" processRef="Process_BuildFromText" />
    <bpmn:participant id="Participant_Ext" name="Провайдер языковой модели" />
    <bpmn:messageFlow id="Message_1" name="роль и JSON-схема" sourceRef="T4" targetRef="Participant_Ext" />
    <bpmn:messageFlow id="Message_2" name="факты с цитатами" sourceRef="Participant_Ext" targetRef="T4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BuildFromText" name="schemix: построение схемы по описанию процесса" isExecutable="false">
    <bpmn:laneSet id="LaneSet_BuildFromText">
      <bpmn:lane id="Lane_Analyst" name="Аналитик"><bpmn:flowNodeRef>S1</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>T6</bpmn:flowNodeRef><bpmn:flowNodeRef>T7</bpmn:flowNodeRef><bpmn:flowNodeRef>G3</bpmn:flowNodeRef><bpmn:flowNodeRef>E2</bpmn:flowNodeRef><bpmn:flowNodeRef>T10</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Server" name="Сервер schemix"><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>G4</bpmn:flowNodeRef><bpmn:flowNodeRef>T8</bpmn:flowNodeRef><bpmn:flowNodeRef>G5</bpmn:flowNodeRef><bpmn:flowNodeRef>T9</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Агент (worker)"><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>G0</bpmn:flowNodeRef><bpmn:flowNodeRef>T4</bpmn:flowNodeRef><bpmn:flowNodeRef>T5</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>G2</bpmn:flowNodeRef><bpmn:flowNodeRef>E3</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Нужна схема процесса"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="T1" name="Описать процесс и запустить построение"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="T2" name="Сохранить сообщение и поставить запрос в очередь"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="T3" name="Взять запрос из очереди по аренде"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G0" name=""><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T4" name="Извлечь факты ролями модели"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="T5" name="Собрать ChangeSet на копии и проверить схему"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Нужно уточнение?"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T6" name="Ответить на вопросы агента"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G2" name="Изменение рискованное?"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T7" name="Просмотреть предложение и предпросмотр"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G3" name="Применить?"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="E2" name="Изменения отклонены"><bpmn:incoming>Flow_13</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="G4" name=""><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T8" name="Сверить базовую ревизию с текущей"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G5" name="Ревизия текущая?"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="E3" name="Запрос устарел"><bpmn:incoming>Flow_18</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="T9" name="Записать ревизию и оповестить клиента"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="T10" name="Проверить схему в редакторе"><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="E1" name="Схема построена"><bpmn:incoming>Flow_21</bpmn:incoming></bpmn:endEvent>
